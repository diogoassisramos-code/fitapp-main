# Supabase — copie para .env.local e preencha (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Supabase service role (SECRETA) — usada só no servidor (handler de webhook do
# Asaas, que escreve ignorando a RLS). Nunca prefixe com NEXT_PUBLIC_.
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Asaas (gateway de pagamento) — SECRETO, só no servidor. Deixe ASAAS_API_KEY em
# branco para rodar sem cobrança real (as rotas /api/asaas/* respondem 503).
# Sandbox: https://api-sandbox.asaas.com/v3 + chave que começa com $aact_hmlg_
# Produção: https://api.asaas.com/v3 + chave que começa com $aact_prod_
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=Revo
# Token compartilhado do webhook: gere um valor aleatório forte e configure o
# MESMO valor como authToken do webhook no painel/API do Asaas.
ASAAS_WEBHOOK_TOKEN=
